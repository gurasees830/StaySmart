PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:5001

# Local MongoDB started by start-staysmart.ps1, or an Atlas connection string
MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017/hotelbooking
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
UNSPLASH_ACCESS_KEY=

# Google Places API (New) - live hotel photos (backend only)
GOOGLE_PLACES_API_KEY=
PLACES_MATCH_MONTHLY_LIMIT=9000
PLACES_PHOTO_MONTHLY_LIMIT=950

# Only if your network cannot resolve mongodb+srv SRV records
# DNS_SERVERS=8.8.8.8,1.1.1.1
